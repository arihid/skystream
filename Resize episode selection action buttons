name: Resize episode selection actions

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  apply:
    runs-on: ubuntu-latest
    timeout-minutes: 35

    steps:
      - name: Checkout main
        uses: actions/checkout@v5
        with:
          ref: main
          fetch-depth: 0

      - name: Update selection action layout
        shell: bash
        run: |
          echo '' | base64 --decode > /tmp/resize_episode_selection_actions.py
          python3 /tmp/resize_episode_selection_actions.py

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Install dependencies
        run: flutter pub get

      - name: Generate Riverpod files
        run: dart run build_runner build --delete-conflicting-outputs

      - name: Format changed file
        run: dart format lib/features/details/presentation/details_screen.dart

      - name: Analyze changed file
        run: flutter analyze lib/features/details/presentation/details_screen.dart

      - name: Verify diff
        run: git diff --check

      - name: Commit change and remove workflow
        shell: bash
        run: |
          rm -f .github/workflows/resize-episode-selection-actions.yml

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add \
            lib/features/details/presentation/details_screen.dart \
            .github/workflows/resize-episode-selection-actions.yml

          git commit -m "Resize episode selection action buttons"
          git push origin HEAD:main
